# Server port (cloud hosts like Render, Railway, and Fly.io set PORT automatically)
PORT=3001

# Required in production: at least 32 bytes of cryptographically random text.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ATTENDQR_SECRET=replace-with-at-least-32-bytes-of-random-secret-data

# Optional PostgreSQL connection string for production cloud hosting (Neon, Supabase, Render, Railway).
# Leave unset to use the built-in local SQLite database (server/data/attendqr.db).
# DATABASE_URL=postgres://user:password@host:5432/attendqr

# Optional custom path for the SQLite database file (useful for persistent disks on Fly.io / Render).
# SQLITE_PATH=./server/data/attendqr.db

# Optional SSL setting for hosted PostgreSQL (set to "false" only for local Postgres without SSL)
# DATABASE_SSL=true

# Optional Google OAuth 2.0 ("Continue with Google" on Sign In / Create Account)
# Create OAuth 2.0 Web Client credentials in Google Cloud Console and add:
#   Authorized redirect URI: http://localhost:3001/api/auth/google/callback
# GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-google-client-secret
# GOOGLE_REDIRECT_URI=http://localhost:3001/api/auth/google/callback

# Email delivery for Sign-Up Verification & Password Reset Codes
# Option A (Recommended): Resend API (free tier at https://resend.com)
# RESEND_API_KEY=re_xxxxxxxxx
# MAIL_FROM=AttendQR <no-reply@yourdomain.com>
#
# Option B: Standard SMTP (e.g. Gmail with an App Password)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-16-char-app-password
# MAIL_FROM=AttendQR <your-email@gmail.com>
#
# Inbox that receives in-app "Report a Problem" submissions
# SUPPORT_EMAIL=attend.qrsupport@gmail.com
