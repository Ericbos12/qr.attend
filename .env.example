# Server port (used for local dev / standalone hosting; Vercel sets serverless routing automatically)
PORT=3001

# Required in production: at least 32 bytes of cryptographically random text.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ATTENDQR_SECRET=replace-with-at-least-32-bytes-of-random-secret-data

# Required on Vercel (recommended for any cloud host): PostgreSQL connection string (Neon, Supabase).
# Leave unset locally to use the built-in SQLite database (server/data/attendqr.db).
# DATABASE_URL=postgres://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# Optional direct (non-pooled) Neon connection string used automatically for schema DDL initialization.
# DATABASE_URL_UNPOOLED=postgres://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# Optional custom path for the SQLite database file (useful for persistent volumes on Fly.io / Railway).
# SQLITE_PATH=./server/data/attendqr.db

# Optional SSL setting for hosted PostgreSQL (set to "false" only for local Postgres without SSL)
# DATABASE_SSL=true

# Optional Google OAuth 2.0 ("Continue with Google" on Sign In / Create Account)
# Create OAuth 2.0 Web Client credentials in Google Cloud Console and add:
#   Authorized redirect URI: http://localhost:3001/api/auth/google/callback
# GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-google-client-secret
# Preapproved exact OAuth callback URI allowlist (required in production; never derived from untrusted requests)
# GOOGLE_REDIRECT_URI=https://your-app-domain.com/api/auth/google/callback
# GOOGLE_ALLOWED_REDIRECT_URIS=https://your-app-domain.com/api/auth/google/callback

# Email delivery for Sign-Up Verification & Password Reset Codes
# Option A (Recommended): Resend API (free tier at https://resend.com)
# RESEND_API_KEY=re_xxxxxxxxx
# MAIL_FROM=AttendQR <no-reply@yourdomain.com>
#
# Option B: Standard SMTP (e.g. Gmail with an App Password)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-16-char-app-password
# MAIL_FROM=AttendQR <your-email@gmail.com>
#
# Inbox that receives in-app "Report a Problem" submissions
# SUPPORT_EMAIL=attend.qrsupport@gmail.com

# Optional comma-separated extra origins allowed to call /api (same-origin is always allowed)
# ALLOWED_ORIGINS=https://your-custom-domain.com

# Exclusive single platform owner email allowed to unlock the hidden /admin Active-Users Monitor.
# Leave empty to disable the owner monitor completely. Never commit real emails to git.
# OWNER_EMAIL=your-owner-email@example.com
